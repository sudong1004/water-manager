# Supabase 프로젝트 → Connect(또는 Project Settings → API Keys) 에서 복사해 .env.local 로 저장하세요.
# 이 두 값이 없으면 앱은 로그인 없이 data/ 폴더 파일에 저장하는 로컬 모드로 동작합니다.
# 따옴표 없이, = 앞뒤 공백 없이 입력하세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# (예전 이름 NEXT_PUBLIC_SUPABASE_ANON_KEY 도 인식합니다)
NEXT_PUBLIC_KAKAO_MAP_KEY=카카오_JavaScript_키
